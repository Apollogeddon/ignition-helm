---

const { tagline, logo } = Astro.props;
const base = import.meta.env.BASE_URL;
const quickStartCode = `helm repo add ignition-charts https://apollogeddon.github.io/ignition-helm
helm install my-ignition ignition-charts/ignition-failover \\
  --set acceptEula=true \\
  --set ignition.secrets.GATEWAY_ADMIN_PASSWORD=<admin password> \\
  --set ignition.secrets.IGNITION_GAN_KEYSTORE_PASSWORD=<gan keystore password> \\
  --set ignition.secrets.IGNITION_WEB_KEYSTORE_PASSWORD=<web keystore password>`;
---

<section class="hero-section">
  <div class="hero-light" aria-hidden="true"></div>

  <div class="content">
    <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Ignition Helm Charts</p>
    <h1>Ignition on Kubernetes, as a redundant pair or at scale.</h1>
    <p class="tagline">{tagline}</p>

    <div class="actions">
      <a href={`${base}/docs/guides/installation/`} class="btn btn-primary">
        Get started
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="https://github.com/apollogeddon/ignition-helm" class="btn btn-secondary">
        View on GitHub
      </a>
    </div>

    <div class="quick-install glass">
      <div class="install-header">
        <span class="label">Quick start</span>
      </div>
      <pre tabindex="0"><code>{quickStartCode}</code></pre>
      <p class="install-note">
        <code>acceptEula=true</code> accepts Inductive Automation's{" "}
        <a href="https://inductiveautomation.com/ignition/license">Ignition EULA</a>: read it first. The charts have no
        default passwords; to keep them out of Helm's values, use an <code>existingSecret</code> instead (see the{" "}
        <a href={`${base}/docs/guides/installation/`}>installation guide</a>).
      </p>
      <button class="copy-btn" id="copy-btn" data-code={quickStartCode} aria-label="Copy to clipboard">
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.querySelector('#copy-btn') as HTMLButtonElement;
  const code = copyBtn?.dataset.code;
  
  copyBtn?.addEventListener('click', async () => {
    if (code) {
      await navigator.clipboard.writeText(code);
      const originalContent = copyBtn.innerHTML;
      copyBtn.innerHTML = '<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      setTimeout(() => {
        copyBtn.innerHTML = originalContent;
      }, 2000);
    }
  });
</script>

<style>
  /* centred on a soft light from the top: a white wash, with the site's accents either side */
  .hero-section {
    position: relative;
    padding: 7rem 1.5rem 5rem;
    text-align: center;
    overflow-x: clip;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-light {
    position: absolute;
    inset: -12rem 0 auto;
    height: 46rem;
    pointer-events: none;
    background:
      radial-gradient(ellipse 42% 55% at 50% 30%, var(--hero-light-white), transparent 70%),
      radial-gradient(ellipse 30% 42% at 30% 34%, color-mix(in srgb, var(--sl-color-accent) var(--hero-light-accent), transparent), transparent 70%),
      radial-gradient(ellipse 30% 42% at 70% 30%, color-mix(in srgb, var(--sl-color-accent-secondary) var(--hero-light-accent), transparent), transparent 70%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  .content {
    position: relative;
    width: 100%;
    min-width: 0;
    max-width: 880px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0.3125rem 0.875rem 0.3125rem 0.625rem;
    border: 1px solid var(--sl-color-hairline-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-surface) 70%, transparent);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sl-color-text-muted);
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0 3px rgba(var(--sl-color-accent-rgb), 0.2);
  }

  /* the headline fades from the text colour to the muted one, as light falls off */
  h1 {
    margin: 0 auto 1.5rem;
    max-width: 20ch;
    font-size: clamp(2.375rem, 6.5vw, 4.25rem);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.045em;
    text-wrap: balance;
    color: var(--sl-color-text);
    background: linear-gradient(180deg, var(--sl-color-text) 35%, var(--sl-color-text-muted));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .tagline {
    margin: 0 auto 2.5rem;
    max-width: 38rem;
    font-size: clamp(1.0625rem, 2.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--sl-color-text-muted);
    text-wrap: balance;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  /* the quick start reads as a terminal window: a title row, then the commands */
  .quick-install {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    border-radius: 12px;
    text-align: left;
    overflow: hidden;
  }

  .install-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--sl-color-text-muted);
  }

  pre {
    margin: 0;
    max-width: 100%;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.75;
    color: var(--sl-color-text);
  }

  .install-note {
    margin: 0;
    padding: 0.875rem 1.25rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--sl-color-text-muted);
  }

  .quick-note {
    margin: 1.25rem auto 0;
    max-width: 720px;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--sl-color-text-muted);
  }

  :is(.install-note, .quick-note) a {
    color: var(--sl-color-text);
    text-decoration: underline;
    text-decoration-color: var(--sl-color-hairline-strong);
    text-underline-offset: 3px;
  }

  :is(.install-note, .quick-note) code {
    font-size: 0.92em;
    color: var(--sl-color-text);
  }

  .copy-btn {
    position: absolute;
    top: 0.25rem;
    right: 0.375rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: none;
    color: var(--sl-color-text-muted);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }

  .copy-btn:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  .copy-btn :global(svg) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 560px) {
    .hero-section {
      padding: 4.5rem 1rem 3.5rem;
    }
  }
</style>

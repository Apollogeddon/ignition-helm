---
import { Image } from "astro:assets";
import logoImage from "../assets/favicon.png";
import ThemeToggle from "./ThemeToggle.astro";

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(/\/+/g, "/");
const link = (href: string) => `${base}${href}`.replace(/\/+/g, "/");
// each link is current while the page is in its section
const links = [
  ["Guides", "/docs/guides/installation/", "/docs/guides/"],
  ["Charts", "/docs/charts/failover/", "/docs/charts/"],
].map(([label, href, section]) => ({ label, href: link(href), current: path.includes(section) }));
---

<header class="navbar">
  <nav class="nav-container" aria-label="Main">
    <a href={link("/")} class="site-title" aria-label="Ignition Helm Charts home">
      <Image src={logoImage} alt="" class="nav-logo" width={22} height={22} />
      <span class="site-title-text">Ignition Helm Charts</span>
    </a>

    <ul class="nav-links">
      {links.map((item) => (
        <li>
          <a href={item.href} class="nav-link" aria-current={item.current ? "page" : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>

    <div class="nav-end">
      <ThemeToggle />
      <a href="https://github.com/apollogeddon/ignition-helm" class="icon-link" aria-label="GitHub repository" target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"/></svg>
      </a>
      <a href={link("/docs/guides/installation/")} class="nav-cta">Get started</a>
    </div>
  </nav>
</header>

<style>
  /* a translucent bar over the page, one hairline below it */
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    box-sizing: border-box;
    height: var(--sl-nav-height);
    background: var(--sl-color-bg-nav);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .nav-container {
    position: relative;
    box-sizing: border-box;
    max-width: 1440px;
    height: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--sl-color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-logo {
    width: 22px;
    height: 22px;
    border-radius: 6px;
  }

  /* the section links sit in the middle of the bar, whatever the title's width */
  .nav-links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--sl-color-text);
  }

  .nav-end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: var(--sl-color-text-muted);
    transition: color 0.15s, background-color 0.15s;
  }

  .icon-link:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    height: 34px;
    margin-left: 0.5rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    background: var(--sl-color-text);
    color: var(--sl-color-bg);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s;
  }

  .nav-cta:hover {
    background: color-mix(in srgb, var(--sl-color-text) 86%, var(--sl-color-bg));
  }

  /* narrower: the links follow the title instead of centring, and the button gives way */
  @media (max-width: 900px) {
    .nav-links {
      position: static;
      transform: none;
    }

    .nav-cta {
      display: none;
    }
  }

  /* a phone: the logo stands for the name, so the links fit on one line */
  @media (max-width: 560px) {
    .nav-container {
      padding: 0 0.75rem;
      gap: 0.25rem;
    }

    .site-title-text {
      display: none;
    }

    .nav-link {
      padding: 0 0.5rem;
    }
  }
</style>

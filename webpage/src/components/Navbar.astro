---
import { Image } from "astro:assets";
import logoImage from "../assets/favicon.png";
import ThemeToggle from "./ThemeToggle.astro";

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(/\/+/g, "/");
const link = (href: string) => `${base}${href}`.replace(/\/+/g, "/");
// each link is current while the page is in its section
const links = [
  ["Guides", "/docs/guides/installation/", "/docs/guides/"],
  ["Charts", "/docs/charts/failover/", "/docs/charts/"],
].map(([label, href, section]) => ({ label, href: link(href), current: path.includes(section) }));
---

<header class="navbar">
  <nav class="nav-container" aria-label="Main">
    <a href={link("/")} class="site-title" aria-label="Ignition Helm Charts home">
      <Image src={logoImage} alt="" class="nav-logo" width={22} height={22} />
      <span class="site-title-text">Ignition Helm Charts</span>
    </a>

    <ul class="nav-links">
      {links.map((item) => (
        <li>
          <a href={item.href} class="nav-link" aria-current={item.current ? "page" : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>

    <div class="nav-end">
      <ThemeToggle />
      <a href="https://github.com/apollogeddon/ignition-helm" class="icon-link" aria-label="GitHub repository" target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
      </a>
      <a href={link("/docs/guides/installation/")} class="nav-cta">Get started</a>
    </div>
  </nav>
</header>

<style>
  /* a translucent bar over the page, one hairline below it */
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    box-sizing: border-box;
    height: var(--sl-nav-height);
    background: var(--sl-color-bg-nav);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .nav-container {
    position: relative;
    box-sizing: border-box;
    max-width: 1440px;
    height: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--sl-color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-logo {
    width: 22px;
    height: 22px;
    border-radius: 6px;
  }

  /* the section links sit in the middle of the bar, whatever the title's width */
  .nav-links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--sl-color-text);
  }

  .nav-end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: var(--sl-color-text-muted);
    transition: color 0.15s, background-color 0.15s;
  }

  .icon-link:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    height: 34px;
    margin-left: 0.5rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    background: var(--sl-color-text);
    color: var(--sl-color-bg);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s;
  }

  .nav-cta:hover {
    background: color-mix(in srgb, var(--sl-color-text) 86%, var(--sl-color-bg));
  }

  /* narrower: the links follow the title instead of centring, and the button gives way */
  @media (max-width: 900px) {
    .nav-links {
      position: static;
      transform: none;
    }

    .nav-cta {
      display: none;
    }
  }

  /* a phone: the logo stands for the name, so the links fit on one line */
  @media (max-width: 560px) {
    .nav-container {
      padding: 0 0.75rem;
      gap: 0.25rem;
    }

    .site-title-text {
      display: none;
    }

    .nav-link {
      padding: 0 0.5rem;
    }
  }
</style>

---
---
<button id="theme-toggle" class="theme-toggle" aria-label="Switch theme">
  <svg aria-hidden="true" focusable="false" class="sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 8a4 4 0 0 0-4 4 4 4 0 0 0 4 4 4 4 0 0 0 4-4 4 4 0 0 0-4-4m0 10a6 6 0 0 1-6-6 6 6 0 0 1 6-6 6 6 0 0 1 6 6 6 6 0 0 1-6 6m8-9.31V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20v-4.69L23.31 12z"/></svg>
  <svg aria-hidden="true" focusable="false" class="moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 18c-.89 0-1.74-.2-2.5-.55C11.56 16.5 13 14.42 13 12s-1.44-4.5-3.5-5.45C10.26 6.2 11.11 6 12 6a6 6 0 0 1 6 6 6 6 0 0 1-6 6m8-9.31V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20v-4.69L23.31 12z"/></svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: none;
    color: var(--sl-color-text-muted);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }

  .theme-toggle:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }

  .theme-toggle :global(svg) {
    width: 18px;
    height: 18px;
  }

  .sun { display: none; }
  .moon { display: block; }

  :root[data-theme='light'] .sun { display: block; }
  :root[data-theme='light'] .moon { display: none; }
</style>

<script is:inline>
  const handleToggleClick = () => {
    const element = document.documentElement;
    const isDark = element.getAttribute('data-theme') === 'dark';
    const newTheme = isDark ? 'light' : 'dark';
    
    element.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
  };

  const toggle = document.getElementById('theme-toggle');
  // the label names the theme a press switches to
  const label = () => {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    toggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
  };
  toggle.addEventListener('click', () => {
    handleToggleClick();
    label();
  });
  label();
</script>

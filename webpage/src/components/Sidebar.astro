---
import { getCollection } from "astro:content";

const docs = await getCollection("docs");
const base = import.meta.env.BASE_URL;
const pathname = new URL(Astro.request.url).pathname;

// Optimized organization logic: single pass to group and sort
const sections = [
  { label: "Guides", prefix: "guides/" },
  { label: "Charts", prefix: "charts/" },
]
  .map((section) => ({
    ...section,
    items: docs
      .filter((d) => d.id.startsWith(section.prefix))
      .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title)),
  }))
  .filter((section) => section.items.length > 0);

/**
 * Checks if a doc link is currently active
 * Handles trailing slashes and base paths consistently
 */
const isActive = (id: string) => {
  const href = `${base}/docs/${id}/`.replace(/\/+/g, "/");
  const current = pathname.replace(/\/+/g, "/");
  return current === href || current === href.slice(0, -1);
};
---

<nav class="sidebar" aria-label="Documentation">
  {sections.map(section => (
    <div class="section">
      <h2 class="section-title">{section.label}</h2>
      <ul class="section-items">
        {section.items.map(item => (
          <li>
            <a 
              href={`${base}/docs/${item.id}/`} 
              class={`sidebar-link ${isActive(item.id) ? 'active' : ''}`}
              aria-current={isActive(item.id) ? 'page' : undefined}
            >
              {item.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  .sidebar {
    padding-right: 1rem;
  }

  .section {
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sl-color-text);
    margin-top: 1.33em;
    margin-bottom: 0.5rem;
    padding-left: 0.75rem;
  }

  .section-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-link {
    display: block;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
    color: var(--sl-color-text-muted);
    border-radius: 8px;
    transition: color 0.15s, background-color 0.15s;
  }

  .sidebar-link:hover {
    color: var(--sl-color-text);
    background: var(--sl-color-gray-6);
  }
</style>

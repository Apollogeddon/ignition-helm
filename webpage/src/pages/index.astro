---
import logoImage from "../assets/favicon.png";
import ArchitectureComparison from "../components/ArchitectureComparison.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Ignition Helm Charts" description="Helm charts for running Inductive Automation's Ignition gateways on Kubernetes.">
  <Hero 
    tagline="Helm charts for running redundant and scaleout Ignition gateways on Kubernetes."
    logo={logoImage}
  />
  
  <FeatureGrid />
  
  <ArchitectureComparison />
  
  <footer class="custom-footer">
    <div class="footer-content">
      <p>Released under the MIT License.</p>
      <p>Built with Astro.</p>
      <p>Ignition is a trademark of Inductive Automation.</p>
    </div>
  </footer>
</BaseLayout>

---
import logoImage from "../assets/favicon.png";
import ArchitectureComparison from "../components/ArchitectureComparison.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const year = new Date().getFullYear();
---

<BaseLayout title="Ignition Helm Charts · Ignition gateways on Kubernetes" description="Helm charts for running Ignition on Kubernetes, as a redundant Master/Backup pair or as separate frontend and backend gateways.">
  <Hero 
    tagline="Helm charts for running Ignition on Kubernetes, as a redundant Master/Backup pair or as separate frontend and backend gateways."
    logo={logoImage}
  />
  
  <FeatureGrid />
  
  <ArchitectureComparison />
  
  <footer class="custom-footer">
    <div class="footer-content">
      <p>© {year} Apollogeddon. Released under the MIT License.</p>
      <p>Ignition is a trademark of Inductive Automation.</p>
    </div>
  </footer>
</BaseLayout>
